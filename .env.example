# Browser-safe values from the shared Supabase project. Never put a service-role
# key, database password, payment secret, or owner credential in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required by the live create-booking Edge Function. Leave blank for the
# clearly labelled private preview mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional canonical origin for social metadata. Sites can otherwise derive the
# absolute URL from the incoming request host.
NEXT_PUBLIC_SITE_URL=
